{
  "name": "dsh-cleaner",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Deletes stored logs, never a live session. List what is still on disk, delete the ids a person approved, and report the bytes reclaimed.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FrozenYty/dsh-cleaner.git"
  },
  "bugs": {
    "url": "https://github.com/FrozenYty/dsh-cleaner/issues"
  },
  "homepage": "https://github.com/FrozenYty/dsh-cleaner#readme",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "session",
    "cleanup",
    "delete"
  ],
  "scripts": {
    "test": "node scripts/test.mjs",
    "check": "node scripts/check.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "engine.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  }
}
